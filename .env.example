# Copy to .env locally; never commit the real .env or paste secrets into chat.
# Required for all database commands. RDS connections always use verify-full TLS.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
# Optional PEM CA bundle; omitted uses the system trust store.
PGSSLROOTCERT=

# Required only for connecting, not for list.
# Base64 OpenSSL enc -aes-128-cbc -a -e -salt output for each value.
ENC_USERNAME=
ENC_PASSWORD=
# Supply the matching encryption passphrase, preferably via process secrets.
DECRYPT_PASSPHRASE=
# sha256 for modern OpenSSL defaults; md5 only for explicitly legacy ciphertext.
DECRYPT_DIGEST=sha256

IDP_ENDPOINT=
IDP_PROVIDER=PingNTLM
REGION=us-east-1
EMAIL_DOMAIN=test.com
KCONNECT_BIN=kconnect

# Required only when the selected environment is exactly prod.
OAUTH_URL=
FIRECALL_URL=
FIRECALL_URI=
# Optional: omit to prompt securely each refresh. Never a command-line flag.
PROD_PASSWORD=
CM_TICKET=
DURATION_IN_HRS=8

INTERVAL=900s
TIMEOUT=15s
COMMAND_TIMEOUT=2m

# Optional diagnostics; independent of --json result output. No remote export.
EKS_LOG_FORMAT=text
EKS_LOG_SOURCE=false
# Parent must exist; owner-only logs rotate at 10 MiB with three archives.
EKS_LOG_FILE=
