modules = ["python-base-3.13", "go-1.26"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cross-compile"

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GOSUMDB=sum.golang.org GOTOOLCHAIN=go1.25.14 make lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GOSUMDB=sum.golang.org GOTOOLCHAIN=go1.25.14 make test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cross-compile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GOSUMDB=sum.golang.org GOTOOLCHAIN=go1.25.14 make build cross-compile"

[workflows.workflow.metadata]
isValidation = true
